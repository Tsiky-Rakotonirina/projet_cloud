# Port du serveur
PORT=3000

# Configuration base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=route
DB_USER=postgres
DB_PASSWORD=your_db_password

# Configuration JWT
JWT_SECRET=9fA7QvL3xEw2JmRk8PZcN4sH0B6TYaUdF5o1iKGSWbC
JWT_EXPIRES_IN=24h

MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCK_DURATION=120000

# Configuration GitHub OAuth (à remplir pour la connexion GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ============================================
# Configuration Firebase Admin SDK
# Ces variables remplacent le fichier firebase-admin-sdk.json
# Copiez les valeurs depuis votre console Firebase
# ============================================
FIREBASE_PROJECT_ID=tp-firebase-b195d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@tp-firebase-b195d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_CLIENT_ID=your_client_id
# IMPORTANT: Copiez la clé privée ENTIÈRE depuis le JSON, incluant -----BEGIN PRIVATE KEY----- et -----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"
